{
  "compilerOptions": {
    "target": "ES2020",
    "module": "none",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "outFile": "public/app.js",
    "removeComments": false,
    "skipLibCheck": true
  },
  "files": ["src/engine.ts", "src/app.ts"]
}
